[Plymouth Theme]
Name=RogueOS
Description=Minimal RogueOS boot and encrypted-root presentation
ModuleName=two-step

[two-step]
Font=Adwaita Sans 12
TitleFont=Adwaita Sans Light 30
MonospaceFont=Adwaita Mono 12

# Reuse the complete, package-owned Spinner asset set, including Arch's
# watermark and the password-entry controls.
ImageDir=/usr/share/plymouth/themes/spinner

# Password dialog and optional titles.
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.50
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.50

# Spinner and Arch watermark.
HorizontalAlignment=.5
VerticalAlignment=.70
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.30

Transition=none
TransitionDuration=0.0

# Midnight Circuit.
BackgroundStartColor=0x0b0f17
BackgroundEndColor=0x0b0f17
ProgressBarBackgroundColor=0x2a3a50
ProgressBarForegroundColor=0x5ce1e6

MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
